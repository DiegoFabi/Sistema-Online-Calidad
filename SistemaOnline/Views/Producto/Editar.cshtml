@model SistemaOnline.ViewModels.ProductoVM
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Editar Producto";
    ViewBag.Active = "negocio";
    string Cls(string campo) => !ViewData.ModelState.ContainsKey(campo) || ViewData.ModelState[campo].Errors.Count == 0
        ? "w-full h-11 px-md bg-surface-container-low border border-transparent rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface"
        : "w-full h-11 px-md bg-surface-container-low border border-error rounded-lg focus:ring-2 focus:ring-error/20 transition-all font-body-md text-body-md text-on-surface";
}
<div class="max-w-2xl mx-auto">
    <div class="mb-lg">
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight">Editar Producto</h2>
        <p class="text-on-surface-variant">Modifica los datos del producto.</p>
    </div>
    <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 p-lg">
        <form id="formProducto" asp-controller="Producto" asp-action="Editar" method="post" autocomplete="off" class="space-y-md">
            <div asp-validation-summary="ModelOnly" class="text-error text-body-md"></div>
            <input type="hidden" asp-for="ID_Producto" />
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="Nombre_Plato">Nombre del Plato</label>
                <input class="@Cls("Nombre_Plato")" type="text" required asp-for="Nombre_Plato" />
                <span asp-validation-for="Nombre_Plato" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="Descripcion">Descripción</label>
                <input class="@Cls("Descripcion")" type="text" required asp-for="Descripcion" />
                <span asp-validation-for="Descripcion" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="Tiempo_Preparacion">Tiempo de Preparación (minutos)</label>
                <input class="@Cls("Tiempo_Preparacion")" type="number" step="0.1" min="0" required asp-for="Tiempo_Preparacion" />
                <span asp-validation-for="Tiempo_Preparacion" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="Precio">Precio unitario por porción</label>
                <input class="@Cls("Precio")" type="number" step="0.01" min="0" required asp-for="Precio" />
                <span asp-validation-for="Precio" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="Disponibilidad">Disponible</label>
                <input class="h-5 w-5 rounded border-outline-variant text-primary focus:ring-primary/20" asp-for="Disponibilidad" type="checkbox" />
                <span asp-validation-for="Disponibilidad" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1" for="ID_Categoria">Categoría</label>
                <select class="@Cls("ID_Categoria")" asp-for="ID_Categoria" asp-items="Model.CategoriasDisponibles">
                    <option value="" disabled selected hidden>-- Seleccione --</option>
                </select>
                <span asp-validation-for="ID_Categoria" class="text-error text-label-md"></span>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface-variant block mb-1">Ingredientes (Receta)</label>
                <button type="button" onclick="openIngredientesModal()"
                        class="w-full inline-flex items-center justify-center gap-sm h-11 px-md bg-surface-container-high text-on-surface font-title-md text-title-md rounded-lg transition-all hover:bg-surface-container-highest">
                    <span class="material-symbols-outlined">kitchen</span>
                    Seleccionar Ingredientes
                </button>
                <div id="resumenIngredientesSeleccionados" class="mt-sm text-label-md text-on-surface-variant">
                    Ningún ingrediente seleccionado.
                </div>
            </div>
            <div class="flex items-center gap-sm pt-md">
                <button type="submit" class="inline-flex items-center gap-sm h-11 px-md bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-title-md text-title-md rounded-lg shadow-md shadow-primary/20 transition-all active:scale-[0.98]">
                    <span class="material-symbols-outlined">save</span> Guardar
                </button>
                <a asp-controller="Producto" asp-action="Lista" class="inline-flex items-center gap-sm h-11 px-md bg-surface-container-high text-on-surface font-title-md text-title-md rounded-lg transition-all hover:bg-surface-container-highest">
                    <span class="material-symbols-outlined">arrow_back</span> Volver
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Ingredientes de la Receta (mismo patrón visual que Detalles del Pedido) -->
<div id="ingredientesModal" class="fixed inset-0 z-[100] hidden items-center justify-center app-modal-overlay">
    <div class="app-modal-panel w-full max-w-[640px] max-h-[85vh] overflow-y-auto flex flex-col animate-fade-in">
        <div class="bg-primary px-lg py-lg flex items-center justify-between sticky top-0 z-10">
            <div class="flex items-center gap-sm text-on-primary">
                <span class="material-symbols-outlined">kitchen</span>
                <h3 class="font-title-md text-title-md">Ingredientes de la Receta</h3>
            </div>
            <button type="button" onclick="closeIngredientesModal()" class="text-on-primary/80 hover:text-on-primary">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div class="p-lg pb-0">
            <div class="relative mb-md">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px] leading-none pointer-events-none select-none">search</span>
                <input id="buscadorIngredientes" type="text" placeholder="Buscar ingrediente..."
                       class="w-full h-11 pl-10 pr-md bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface placeholder:text-outline/60" />
            </div>
        </div>
        <div class="p-lg pt-0 space-y-lg">
            @foreach (var categoria in Model.CategoriasIngredientes)
            {
                <div class="bg-surface-container-low rounded-lg p-md">
                    <p class="flex items-center gap-xs font-bold text-on-surface mb-sm">
                        <span class="material-symbols-outlined text-[18px] text-primary">category</span>
                        @categoria.Nombre_Categoria
                    </p>
                    <div class="space-y-xs">
                        @if (!categoria.Ingredientes.Any())
                        {
                            <p class="text-label-md text-on-surface-variant italic">Sin ingredientes en esta categoría.</p>
                        }
                        @foreach (var ingrediente in categoria.Ingredientes)
                        {
                            bool seleccionado = Model.IngredientesSeleccionados.Contains(ingrediente.ID_Ingrediente);
                            decimal cantInicial = seleccionado && Model.CantidadesIngredientes.TryGetValue(ingrediente.ID_Ingrediente, out decimal c) ? c : 1m;
                            <div class="ingrediente-fila flex items-center justify-between gap-sm py-xs px-sm rounded-md hover:bg-surface-container-high" data-filtro-nombre="@ingrediente.Nombre_Ingrediente.ToLower()">
                                <label class="flex items-center gap-sm text-body-md cursor-pointer flex-1">
                                    <input type="checkbox" name="IngredientesSeleccionados" value="@ingrediente.ID_Ingrediente"
                                           form="formProducto"
                                           @(seleccionado ? "checked" : "")
                                           data-nombre="@ingrediente.Nombre_Ingrediente"
                                           data-id="@ingrediente.ID_Ingrediente"
                                           class="ingrediente-checkbox h-5 w-5 rounded border-outline-variant text-primary focus:ring-primary/20"
                                           onchange="toggleStepperIngrediente(this)" />
                                    @ingrediente.Nombre_Ingrediente
                                </label>
                                <div class="flex items-center gap-xs">
                                    <div class="stepper-ingrediente @(seleccionado ? "flex" : "hidden") items-center gap-xs" id="stepper-ing-@ingrediente.ID_Ingrediente">
                                        <button type="button" onclick="changeQtyIngrediente(this, -0.1)" class="w-7 h-7 flex-shrink-0 rounded-full bg-surface-container-highest text-on-surface text-label-md font-bold flex items-center justify-center hover:bg-primary hover:text-on-primary transition-colors">−</button>
                                        <input type="number" name="CantidadesIngredientes[@ingrediente.ID_Ingrediente]" form="formProducto"
                                               id="qty-ing-@ingrediente.ID_Ingrediente" value="@cantInicial.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0.001" max="999" step="0.001"
                                               data-id="@ingrediente.ID_Ingrediente"
                                               class="w-20 h-8 text-center bg-surface-container-low rounded text-body-md font-mono-data border border-outline-variant/40 focus:outline-none focus:border-primary qty-ingrediente-input"
                                               oninput="actualizarResumenIngredientes()" />
                                        <button type="button" onclick="changeQtyIngrediente(this, 0.1)" class="w-7 h-7 flex-shrink-0 rounded-full bg-surface-container-highest text-on-surface text-label-md font-bold flex items-center justify-center hover:bg-primary hover:text-on-primary transition-colors">+</button>
                                    </div>
                                    <span class="text-label-md font-mono-data text-on-surface-variant">@ingrediente.Unidad_Medida</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="flex gap-md w-full p-lg pt-0 sticky bottom-0 bg-surface-container-lowest">
            <button type="button" onclick="closeIngredientesModal()"
                    class="flex-1 px-md py-sm rounded-lg bg-primary text-on-primary font-bold hover:bg-on-primary-fixed-variant transition-all">
                Listo
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openIngredientesModal() {
            document.getElementById('ingredientesModal').classList.remove('hidden');
            document.getElementById('ingredientesModal').classList.add('flex');
        }
        function closeIngredientesModal() {
            document.getElementById('ingredientesModal').classList.add('hidden');
            document.getElementById('ingredientesModal').classList.remove('flex');
            actualizarResumenIngredientes();
        }

        function toggleStepperIngrediente(cb) {
            const id = cb.getAttribute('data-id');
            const stepperEl = document.getElementById('stepper-ing-' + id);
            if (cb.checked) {
                stepperEl.classList.remove('hidden');
                stepperEl.classList.add('flex');
            } else {
                stepperEl.classList.add('hidden');
                stepperEl.classList.remove('flex');
            }
            actualizarResumenIngredientes();
        }

        function changeQtyIngrediente(btn, delta) {
            const stepperEl = btn.parentElement;
            const input = stepperEl.querySelector('.qty-ingrediente-input');
            let val = parseFloat(input.value) || 1;
            val = Math.max(0.001, Math.min(999, Math.round((val + delta) * 1000) / 1000));
            input.value = val;
            actualizarResumenIngredientes();
        }

        function actualizarResumenIngredientes() {
            const checkboxes = document.querySelectorAll('.ingrediente-checkbox:checked');
            const resumen = document.getElementById('resumenIngredientesSeleccionados');
            if (checkboxes.length === 0) {
                resumen.textContent = 'Ningún ingrediente seleccionado.';
                return;
            }
            const nombres = Array.from(checkboxes).map(function (cb) { return cb.getAttribute('data-nombre'); });
            resumen.textContent = nombres.join(', ');
        }

        document.addEventListener('DOMContentLoaded', function () {
            actualizarResumenIngredientes();

            document.getElementById('buscadorIngredientes').addEventListener('input', function () {
                const filtro = this.value.trim().toLowerCase();
                document.querySelectorAll('.ingrediente-fila').forEach(function (fila) {
                    const nombre = fila.getAttribute('data-filtro-nombre') || '';
                    fila.style.display = nombre.includes(filtro) ? '' : 'none';
                });
            });
        });
    </script>
}