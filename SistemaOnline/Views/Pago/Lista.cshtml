@model List<SistemaOnline.ViewModels.PagoVM>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Pagos";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Pagos";
    ViewData["Descripcion"] = "Administra los pagos registrados.";
    ViewData["Controlador"] = "Pago";
    ViewData["NuevoTexto"] = "Nuevo Pago";
    ViewData["BuscadorPlaceholder"] = "Buscar por método, estado, pedido...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold">Fecha y Hora</th>
                    <th class="px-md pb-md font-bold">Monto</th>
                    <th class="px-md pb-md font-bold">Método de Pago</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Detalles de Tarjeta</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Pedido</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Pago</td>
                        <td class="px-md py-md font-mono-data">@item.Fecha_Hora_Pago.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-md py-md font-mono-data">@item.Monto</td>
                        <td class="px-md py-md font-bold">@item.Metodo_Pago</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Detalles_Tarjeta">@item.Detalles_Tarjeta</td>
                        <td class="px-md py-md">@item.Estado</td>
                        <td class="px-md py-md col-ellipsis" title="@item.PedidoInfo">@item.PedidoInfo</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Pago" asp-action="Editar" asp-route-id="@item.ID_Pago" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Pago" asp-action="Eliminar" asp-route-id="@item.ID_Pago" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />