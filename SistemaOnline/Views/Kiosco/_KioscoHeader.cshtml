@model string
@* Cabecera compartida de las vistas del kiosco. Modelo: sección activa ("Carta" o "Reservaciones"). *@
@{
    const string activa = "px-4 py-2 rounded-full bg-white/20 transition-colors";
    const string inactiva = "px-4 py-2 rounded-full hover:bg-white/20 transition-colors";
    bool esCarta = Model == "Carta";
}
<header class="bg-[#212529] text-white px-4 md:px-8 py-4 flex items-center justify-between shadow-md sticky top-0 z-30">
    <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[32px] text-[#ff9aa2]" aria-hidden="true">restaurant_menu</span>
        <h1 class="text-xl md:text-2xl font-extrabold tracking-tight">Rancho Sagrado</h1>
    </div>
    <nav class="hidden md:flex gap-2 text-base font-bold">
        <a class="@(esCarta ? activa : inactiva)" aria-current="@(esCarta ? "page" : null)" asp-controller="Kiosco" asp-action="Index">Carta</a>
        <a class="@(esCarta ? inactiva : activa)" aria-current="@(esCarta ? null : "page")" asp-controller="Kiosco" asp-action="Reservaciones">Reservaciones</a>
    </nav>
    <div class="flex items-center gap-xs md:gap-sm">
        <a class="px-3 md:px-4 py-2 rounded-full border border-white/40 text-white text-sm md:text-base font-bold hover:bg-white/10 transition-all" asp-controller="Login" asp-action="Login">
            Iniciar Sesión
        </a>
        <a class="px-3 md:px-4 py-2 rounded-full bg-primary text-white text-sm md:text-base font-bold hover:bg-on-primary-fixed-variant transition-all shadow-md shadow-primary/30" asp-controller="Login" asp-action="Registro">
            Registrarse
        </a>
    </div>
</header>