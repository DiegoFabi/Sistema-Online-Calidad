@model SistemaOnline.ViewModels.KioscoReservaVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rancho Sagrado - Reservar Mesa</title>
    <partial name="_DesignTokensHead" />
</head>
<body class="bg-[#f8f9fa] text-on-surface font-body-md min-h-screen">
    <header class="bg-[#212529] text-white px-8 py-6 flex items-center justify-between shadow-md">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[36px]">restaurant_menu</span>
            <h1 class="text-3xl font-extrabold tracking-tight">Rancho Sagrado</h1>
        </div>
        <nav class="flex gap-4 text-lg font-bold">
            <a class="px-4 py-2 rounded-full hover:bg-white/20" asp-controller="Kiosco" asp-action="Index">Carta</a>
            <a class="px-4 py-2 rounded-full bg-white/20" asp-controller="Kiosco" asp-action="Reservaciones">Reservaciones</a>
        </nav>
    </header>

    <main class="px-8 py-10 max-w-xl mx-auto">
        <h2 class="text-4xl font-extrabold mb-2">Reservar Mesa @Model.Numero_Mesa</h2>
        <p class="text-lg text-[#5b4040] mb-8">Completa los datos de tu reservación.</p>

        <div class="bg-white rounded-2xl shadow-lg p-8 border border-[#e3bebd]">
            <div asp-validation-summary="ModelOnly" class="text-[#b9172f] font-bold mb-4"></div>
            <form asp-controller="Kiosco" asp-action="Reservar" method="post" autocomplete="off" class="space-y-4">
                <input type="hidden" asp-for="ID_Mesa" />
                <input type="hidden" asp-for="Numero_Mesa" />

                <div>
                    <label class="font-bold block mb-1" for="Fecha_Hora">Fecha y hora</label>
                    <input class="w-full h-11 px-3 rounded-lg border border-[#e3bebd]" type="datetime-local" required step="60"
                           id="Fecha_Hora" name="Fecha_Hora" value="@Model.Fecha_Hora.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="Fecha_Hora" class="text-[#b9172f] text-sm"></span>
                </div>

                <div>
                    <label class="font-bold block mb-1" for="Numero_Personas">Número de personas</label>
                    <input class="w-full h-11 px-3 rounded-lg border border-[#e3bebd]" type="number" min="1" max="50" required asp-for="Numero_Personas" />
                    <span asp-validation-for="Numero_Personas" class="text-[#b9172f] text-sm"></span>
                </div>

                <div>
                    <label class="font-bold block mb-1" for="Ocasion_Especial">Ocasión especial</label>
                    <input class="w-full h-11 px-3 rounded-lg border border-[#e3bebd]" type="text" required asp-for="Ocasion_Especial" placeholder="Cumpleaños, Aniversario, Ninguna..." />
                    <span asp-validation-for="Ocasion_Especial" class="text-[#b9172f] text-sm"></span>
                </div>

                <div>
                    <label class="font-bold block mb-1" for="Notas">Notas (opcional)</label>
                    <input class="w-full h-11 px-3 rounded-lg border border-[#e3bebd]" type="text" asp-for="Notas" placeholder="Alguna indicación para tu mesa..." />
                    <span asp-validation-for="Notas" class="text-[#b9172f] text-sm"></span>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" class="bg-[#b9172f] text-white rounded-full px-8 py-3 font-bold hover:bg-[#92001f] transition-colors">
                        Confirmar reservación
                    </button>
                    <a asp-controller="Kiosco" asp-action="Reservaciones" class="px-8 py-3 font-bold rounded-full border border-[#8f6f6f]">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </main>
</body>
</html>