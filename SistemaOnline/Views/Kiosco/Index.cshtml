@model SistemaOnline.ViewModels.KioscoMenuVM
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rancho Sagrado - Kiosco</title>
    <partial name="_DesignTokensHead" />
    <style>
        .kiosco-hero-img {
        animation: kiosco-kenburns 18s ease-in-out infinite alternate;
        }
        @@keyframes kiosco-kenburns {
        0% { transform: scale(1) translate(0, 0); }
        100% { transform: scale(1.1) translate(-1%, -1%); }
        }
        @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
        animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .kiosco-delay-1 { animation-delay: .05s; opacity: 0; }
        .kiosco-delay-2 { animation-delay: .12s; opacity: 0; }
        .kiosco-delay-3 { animation-delay: .19s; opacity: 0; }
        .producto-card {
        animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
        }
    </style>
</head>
<body class="bg-[#f8f9fa] text-on-surface font-body-md min-h-screen">
    <header class="bg-[#212529] text-white px-4 md:px-8 py-4 flex items-center justify-between shadow-md sticky top-0 z-30">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[32px] text-primary">restaurant_menu</span>
            <h1 class="text-xl md:text-2xl font-extrabold tracking-tight">Rancho Sagrado</h1>
        </div>
        <nav class="hidden md:flex gap-2 text-base font-bold">
            <a class="px-4 py-2 rounded-full bg-white/20 transition-colors" asp-controller="Kiosco" asp-action="Index">Carta</a>
            <a class="px-4 py-2 rounded-full hover:bg-white/20 transition-colors" asp-controller="Kiosco" asp-action="Reservaciones">Reservaciones</a>
        </nav>
        <div class="flex items-center gap-xs md:gap-sm">
            <a class="px-3 md:px-4 py-2 rounded-full border border-white/40 text-white text-sm md:text-base font-bold hover:bg-white/10 transition-all" asp-controller="Login" asp-action="Login">
                Iniciar Sesión
            </a>
            <a class="px-3 md:px-4 py-2 rounded-full bg-primary text-white text-sm md:text-base font-bold hover:bg-on-primary-fixed-variant transition-all shadow-md shadow-primary/30" asp-controller="Login" asp-action="Registro">
                Registrarse
            </a>
        </div>
    </header>

    <div class="relative h-[260px] md:h-[340px] overflow-hidden">
        <img src="~/images/hero-interior.webp" alt="Ambiente de El Rancho Sagrado" class="kiosco-hero-img absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/55"></div>
        <div class="relative z-10 h-full flex flex-col justify-center px-6 md:px-12 max-w-6xl mx-auto">
            <p class="text-primary-fixed-dim font-bold uppercase tracking-[0.2em] text-sm mb-xs animate-fade-in-up">Autoservicio</p>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white uppercase tracking-tight animate-fade-in-up kiosco-delay-1">Nuestra Carta</h2>
            <p class="text-white/80 text-base md:text-lg mt-sm max-w-xl animate-fade-in-up kiosco-delay-2">Selecciona tus platos favoritos y arma tu pedido en minutos.</p>
        </div>
    </div>

    <main class="px-4 md:px-8 py-8 max-w-6xl mx-auto">
        <div class="flex flex-wrap gap-3 mb-8">
            <a asp-controller="Kiosco" asp-action="Index"
               class="px-5 py-2 rounded-full font-bold transition-colors @(Model.CategoriaSeleccionada == null ? "bg-[#b9172f] text-white" : "bg-white text-[#5b4040] border border-[#e3bebd] hover:bg-[#f8f9fa]")">
                Todos
            </a>
            @foreach (var c in Model.Categorias)
            {
                <a asp-controller="Kiosco" asp-action="Index" asp-route-categoria="@c.ID_Categoria"
                   class="px-5 py-2 rounded-full font-bold transition-colors @(Model.CategoriaSeleccionada == c.ID_Categoria ? "bg-[#b9172f] text-white" : "bg-white text-[#5b4040] border border-[#e3bebd] hover:bg-[#f8f9fa]")">
                    @c.Nombre_Categoria
                </a>
            }
        </div>

        <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (!Model.Productos.Any())
            {
                <p class="text-lg text-[#5b4040] col-span-full">No hay productos disponibles en esta categoría.</p>
            }
            @{ int cardIndex = 0; }
            @foreach (var p in Model.Productos)
            {
                cardIndex++;
                <div class="producto-card bg-white rounded-2xl shadow-lg p-6 flex flex-col gap-3 border border-[#e3bebd] hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                     style="animation-delay: @(Math.Min(cardIndex * 0.05, 0.4))s">
                    <span class="text-xs font-bold uppercase tracking-widest text-[#b9172f]">@p.Producto_Categoria.Nombre_Categoria</span>
                    <h3 class="text-2xl font-bold">@p.Nombre_Plato</h3>
                    <p class="text-[#5b4040] flex-1">@p.Descripcion</p>
                    <div class="flex items-center justify-between mt-2">
                        <span class="text-2xl font-extrabold text-[#b9172f]">@p.Precio.ToString("C2")</span>
                        <button type="button" data-nombre="@p.Nombre_Plato" data-precio="@p.Precio"
                                class="btn-agregar bg-[#b9172f] text-white rounded-full px-5 py-2 font-bold hover:bg-[#92001f] transition-colors">
                            Agregar
                        </button>
                    </div>
                </div>
            }
        </div>
    </main>

    <div id="carritoFlotante" class="fixed bottom-6 right-6 bg-[#b9172f] text-white rounded-full shadow-xl px-6 py-4 font-bold flex items-center gap-2 cursor-pointer">
        <span class="material-symbols-outlined">shopping_cart</span>
        <span id="carritoCount">0</span> ítems
    </div>

    <div id="modalPedido" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-2xl p-8 max-w-md w-full">
            <h3 class="text-2xl font-bold mb-4">Tu pedido</h3>
            <ul id="listaPedido" class="space-y-2 mb-4 max-h-60 overflow-y-auto"></ul>
            <p class="font-bold text-lg mb-4">Total: <span id="totalPedido">S/ 0.00</span></p>
            <div class="flex gap-3">
                <button onclick="cerrarModal()" class="flex-1 px-4 py-2 rounded-lg border border-[#8f6f6f] font-bold">Cerrar</button>
                <button onclick="confirmarPedido()" class="flex-1 px-4 py-2 rounded-lg bg-[#b9172f] text-white font-bold">Realizar Pedido</button>
            </div>
        </div>
    </div>

    <script>
        const carrito = [];
        const carritoFlotante = document.getElementById('carritoFlotante');
        const modalPedido = document.getElementById('modalPedido');

        document.querySelectorAll('.btn-agregar').forEach(function (btn) {
            btn.addEventListener('click', function () {
                carrito.push({ nombre: btn.dataset.nombre, precio: parseFloat(btn.dataset.precio) });
                document.getElementById('carritoCount').textContent = carrito.length;
            });
        });

        carritoFlotante.addEventListener('click', function () {
            const lista = document.getElementById('listaPedido');
            lista.innerHTML = carrito.map(function (item) {
                return '<li class="flex justify-between"><span>' + item.nombre + '</span><span>S/ ' + item.precio.toFixed(2) + '</span></li>';
            }).join('');
            const total = carrito.reduce(function (acc, item) { return acc + item.precio; }, 0);
            document.getElementById('totalPedido').textContent = 'S/ ' + total.toFixed(2);
            modalPedido.classList.remove('hidden');
            modalPedido.classList.add('flex');
        });

        function cerrarModal() {
            modalPedido.classList.add('hidden');
            modalPedido.classList.remove('flex');
        }

        modalPedido.addEventListener('click', function (e) {
            if (e.target === modalPedido) cerrarModal();
        });

        function confirmarPedido() {
            alert('Pedido registrado. Un mesero confirmará tu solicitud en breve.');
            carrito.length = 0;
            document.getElementById('carritoCount').textContent = '0';
            cerrarModal();
        }
    </script>
</body>
</html>