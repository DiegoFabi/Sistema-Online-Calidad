@model List<SistemaOnline.Models.Mesa_Restaurante>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rancho Sagrado - Reservaciones</title>
    <partial name="_DesignTokensHead" />
    <style>
        .kiosco-hero-img {
        animation: kiosco-kenburns 18s ease-in-out infinite alternate;
        }
        @@keyframes kiosco-kenburns {
        0% { transform: scale(1) translate(0, 0); }
        100% { transform: scale(1.1) translate(-1%, -1%); }
        }
        @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
        animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .mesa-card {
        animation: fade-in-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
        }
    </style>
</head>
<body class="bg-[#f8f9fa] text-on-surface font-body-md min-h-screen">
    <header class="bg-[#212529] text-white px-4 md:px-8 py-4 flex items-center justify-between shadow-md sticky top-0 z-30">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-[32px] text-primary">restaurant_menu</span>
            <h1 class="text-xl md:text-2xl font-extrabold tracking-tight">Rancho Sagrado</h1>
        </div>
        <nav class="hidden md:flex gap-2 text-base font-bold">
            <a class="px-4 py-2 rounded-full hover:bg-white/20 transition-colors" asp-controller="Kiosco" asp-action="Index">Carta</a>
            <a class="px-4 py-2 rounded-full bg-white/20 transition-colors" asp-controller="Kiosco" asp-action="Reservaciones">Reservaciones</a>
        </nav>
        <div class="flex items-center gap-xs md:gap-sm">
            <a class="px-3 md:px-4 py-2 rounded-full border border-white/40 text-white text-sm md:text-base font-bold hover:bg-white/10 transition-all" asp-controller="Login" asp-action="Login">
                Iniciar Sesión
            </a>
            <a class="px-3 md:px-4 py-2 rounded-full bg-primary text-white text-sm md:text-base font-bold hover:bg-on-primary-fixed-variant transition-all shadow-md shadow-primary/30" asp-controller="Login" asp-action="Registro">
                Registrarse
            </a>
        </div>
    </header>

    <div class="relative h-[200px] md:h-[260px] overflow-hidden">
        <img src="~/images/hero-buffet.webp" alt="Mesa servida en El Rancho Sagrado" class="kiosco-hero-img absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/55"></div>
        <div class="relative z-10 h-full flex flex-col justify-center px-6 md:px-12 max-w-6xl mx-auto">
            <p class="text-primary-fixed-dim font-bold uppercase tracking-[0.2em] text-sm mb-xs animate-fade-in-up">Reservaciones</p>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white uppercase tracking-tight animate-fade-in-up">Reserva tu mesa</h2>
        </div>
    </div>

    <main class="px-4 md:px-8 py-10 max-w-4xl mx-auto">
        <p class="text-lg text-[#5b4040] mb-8">Mesas disponibles para hoy. Inicia sesión para confirmar tu reservación.</p>

        @if (TempData["Exito"] != null)
        {
            <p class="bg-[#e3f3e3] text-[#1e6b1e] font-bold rounded-lg px-4 py-3 mb-6">@TempData["Exito"]</p>
        }
        @if (TempData["Error"] != null)
        {
            <p class="bg-[#fbe3e3] text-[#b9172f] font-bold rounded-lg px-4 py-3 mb-6">@TempData["Error"]</p>
        }

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
            @{ int mesaIndex = 0; }
            @foreach (var m in Model)
            {
                mesaIndex++;
                <div class="mesa-card bg-white rounded-2xl shadow-lg p-6 text-center border border-[#e3bebd] flex flex-col items-center gap-2 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
                     style="animation-delay: @(Math.Min(mesaIndex * 0.05, 0.4))s">
                    <span class="material-symbols-outlined text-[#b9172f] text-[40px]">table_restaurant</span>
                    <p class="text-xl font-bold mt-1">Mesa @m.Numero_Mesa</p>
                    <p class="text-[#5b4040]">Capacidad: @m.Capacidad</p>
                    <a asp-controller="Kiosco" asp-action="Reservar" asp-route-idMesa="@m.ID_Mesa"
                       class="mt-2 inline-block bg-[#b9172f] text-white rounded-full px-5 py-2 font-bold hover:bg-[#92001f] transition-colors">
                        Reservar
                    </a>
                </div>
            }
        </div>

        <a asp-controller="Login" asp-action="Login" class="inline-block text-[#5b4040] font-bold underline">
            ¿No tienes sesión iniciada? Inicia sesión para reservar
        </a>
    </main>
</body>
</html>