@model List<SistemaOnline.ViewModels.InventarioVM>
@using SistemaOnline.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Inventario de Ingredientes";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Inventario de Ingredientes";
    ViewData["Descripcion"] = "Consulta y ajusta el stock de los ingredientes ya registrados.";
    // "Controlador" se deja en Inventario para que la paginación y los enlaces de este mismo
    // listado (ver _Pagination.cshtml) sigan apuntando aquí. Solo el botón "Nuevo" lleva a
    // Ingrediente/Nuevo (vía NuevoControlador): los registros de Inventario ya no se crean de
    // forma manual e independiente, se generan automáticamente al registrar un Ingrediente
    // (ver IngredienteController.Nuevo), que además recibe "retorno=Inventario" para volver
    // aquí en vez de a Ingrediente/Lista al terminar.
    ViewData["Controlador"] = "Inventario";
    ViewData["NuevoControlador"] = "Ingrediente";
    ViewData["NuevoTexto"] = "Nuevo Ingrediente";
    ViewData["BuscadorPlaceholder"] = "Buscar por ingrediente...";
}
<partial name="_CRUDListLayout" />
<div class="mb-md">
    <a asp-controller="Inventario" asp-action="RegistrarCompra" class="inline-flex items-center gap-sm h-11 px-md bg-surface-container-high text-on-surface font-title-md text-title-md rounded-lg transition-all hover:bg-surface-container-highest">
        <span class="material-symbols-outlined">add_shopping_cart</span> Registrar Compra a Proveedor
    </a>
</div>
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold">Cantidad en Stock</th>
                    <th class="px-md pb-md font-bold">Última Reposición</th>
                    <th class="px-md pb-md font-bold">Stock Mínimo</th>
                    <th class="px-md pb-md font-bold">Stock Máximo</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Ingrediente</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    var estadoStock = EstadoColores.InventarioEstado(item.Cantidad_Stock, item.Stock_Minimo, item.Stock_Maximo);
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Inventario</td>
                        <td class="px-md py-md font-mono-data">@item.Cantidad_Stock</td>
                        <td class="px-md py-md font-mono-data">@item.Fecha_Ultima_Reposicion.ToString("dd/MM/yyyy")</td>
                        <td class="px-md py-md font-mono-data">@item.Stock_Minimo</td>
                        <td class="px-md py-md font-mono-data">@item.Stock_Maximo</td>
                        <td class="px-md py-md">
                            <span class="px-sm py-xs rounded-full text-label-md font-bold @estadoStock.Clases">@estadoStock.Texto</span>
                        </td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.IngredienteNombre">
                            <a asp-controller="Inventario" asp-action="Editar" asp-route-id="@item.ID_Inventario" class="hover:text-primary hover:underline transition-colors">
                                @item.IngredienteNombre
                            </a>
                        </td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Inventario" asp-action="Editar" asp-route-id="@item.ID_Inventario" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Inventario" asp-action="Eliminar" asp-route-id="@item.ID_Inventario" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />