@model SistemaOnline.ViewModels.RecuperarPasswordVM;
@{
    Layout = null;
    string Cls(string campo) => !ViewData.ModelState.ContainsKey(campo) || ViewData.ModelState[campo].Errors.Count == 0
        ? "w-full h-12 pl-[48px] pr-md bg-surface-container-low border border-transparent rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface placeholder:text-outline/60"
        : "w-full h-12 pl-[48px] pr-md bg-surface-container-low border border-error rounded-lg focus:ring-2 focus:ring-error/20 transition-all font-body-md text-body-md text-on-surface placeholder:text-outline/60";
}

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rancho Sagrado - Recuperar Contraseña</title>
    <partial name="_DesignTokensHead" />
    <style>
        .auth-card-glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
        }
        .rancho-pattern {
            background-color: #f8f9fa;
            background-image: radial-gradient(#b9172f 0.5px, transparent 0.5px), radial-gradient(#b9172f 0.5px, #f8f9fa 0.5px);
            background-size: 20px 20px;
            background-position: 0 0,10px 10px;
            opacity: 0.05;
        }
        @@keyframes fade-in {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fade-in 0.4s ease-out forwards;
        }
    </style>
</head>
<body class="bg-background font-body-md text-on-background min-h-screen flex items-center justify-center p-md overflow-hidden relative">
    <div class="absolute inset-0 z-0">
        <div class="rancho-pattern absolute inset-0"></div>
    </div>
    <main class="relative z-10 w-full max-w-[480px] animate-fade-in transition-all duration-500">
        <div class="flex flex-col items-center mb-lg">
            <div class="flex items-center gap-sm mb-base">
                <div class="bg-primary p-base rounded-lg shadow-md">
                    <span class="material-symbols-outlined text-white text-[32px]">restaurant_menu</span>
                </div>
                <h1 class="font-headline-lg text-headline-lg text-primary tracking-tight">Rancho Sagrado</h1>
            </div>
            <p class="font-label-md text-label-md text-on-surface-variant uppercase tracking-widest">Sistema Online de Gestión Operativa</p>
        </div>
        <div class="auth-card-glass shadow-xl rounded-xl p-lg border border-outline-variant/30">
            <button class="mb-lg flex items-center gap-xs text-on-surface-variant hover:text-primary transition-colors" type="button" onclick="window.location.href='@Url.Action("Login", "Login")'">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                <span class="font-label-md text-label-md">Volver al inicio de sesion</span>
            </button>
            <div class="mb-lg">
                <h2 class="font-title-md text-title-md text-on-surface mb-base">Recuperar contraseña</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">Ingresa el correo con el que te registraste y te ayudaremos a restablecer tu contraseña.</p>
            </div>
            <form class="space-y-md" asp-controller="Login" asp-action="RecuperarPassword" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-error text-body-md"></div>
                <div class="space-y-base">
                    <label class="font-label-md text-label-md text-on-surface-variant block" for="Email">Correo Electronico</label>
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">mail</span>
                        <input class="@Cls("Email")" id="Email" placeholder="ej. chef.garcia@rancho.com" type="email" required asp-for="Email" />
                    </div>
                    <span asp-validation-for="Email" class="text-error text-label-md"></span>
                </div>
                <button class="w-full h-12 bg-primary hover:bg-on-primary-fixed-variant text-white font-title-md text-title-md rounded-lg shadow-lg shadow-primary/20 active:scale-[0.98] transition-all duration-150 flex items-center justify-center gap-sm mt-lg" type="submit">
                    Continuar
                    <span class="material-symbols-outlined">arrow_forward</span>
                </button>
            </form>
        </div>
    </main>
</body>
</html>
