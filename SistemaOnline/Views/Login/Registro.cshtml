@model SistemaOnline.ViewModels.RegistroVM;
@{
    Layout = null;
    string Cls(string campo) => !ViewData.ModelState.ContainsKey(campo) || ViewData.ModelState[campo].Errors.Count == 0
        ? "w-full h-12 pl-[48px] pr-md bg-surface-container-low border border-transparent rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface placeholder:text-outline/60"
        : "w-full h-12 pl-[48px] pr-md bg-surface-container-low border border-error rounded-lg focus:ring-2 focus:ring-error/20 transition-all font-body-md text-body-md text-on-surface placeholder:text-outline/60";
}

<!DOCTYPE html>
<html class="light" lang="es">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Rancho Sagrado - Registro</title>
    <partial name="_DesignTokensHead" />
    <style>
        .auth-hero-img {
        animation: auth-kenburns 18s ease-in-out infinite alternate;
        }
        @@keyframes auth-kenburns {
        0% { transform: scale(1) translate(0, 0); }
        100% { transform: scale(1.12) translate(-1%, -1%); }
        }
        @@keyframes fade-in-up {
        from { opacity: 0; transform: translateY(14px); }
        to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
        animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .auth-delay-1 { animation-delay: .05s; opacity: 0; }
        .auth-delay-2 { animation-delay: .12s; opacity: 0; }
        .auth-delay-3 { animation-delay: .19s; opacity: 0; }
    </style>
</head>
<body class="bg-background font-body-md text-on-background min-h-screen overflow-x-hidden">
    <div class="min-h-screen flex flex-col lg:flex-row">
        <!-- Panel de imagen -->
        <div class="relative w-full lg:w-1/2 min-h-[260px] lg:min-h-screen overflow-hidden">
            <img src="~/images/hero-terraza.webp" alt="Terraza de El Rancho Sagrado" class="auth-hero-img absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/60"></div>
            <div class="relative z-10 h-full flex flex-col justify-between p-lg lg:p-xl">
                <div class="flex items-center gap-sm animate-fade-in-up">
                    <div class="bg-primary p-sm rounded-lg shadow-md">
                        <span class="material-symbols-outlined text-white text-[26px]">restaurant_menu</span>
                    </div>
                    <span class="font-title-md text-title-md text-white tracking-tight">El Rancho Sagrado</span>
                </div>
                <div class="animate-fade-in-up auth-delay-2 max-w-lg">
                    <p class="font-label-md text-label-md text-primary-fixed-dim uppercase tracking-[0.2em] mb-sm">Sistema Online de Gestión</p>
                    <h2 class="font-display-lg text-display-lg lg:text-[56px] lg:leading-[1.02] text-white uppercase tracking-tight">
                        Únete al <span class="text-primary-fixed-dim">equipo</span><br class="hidden lg:block" /> del Rancho
                    </h2>
                    <p class="mt-md text-white/75 font-body-md text-body-md max-w-md hidden lg:block">
                        Crea tu acceso en minutos y empieza a gestionar pedidos, reservas y más desde un solo lugar.
                    </p>
                </div>
                <p class="font-label-md text-label-md text-white/50 uppercase tracking-widest animate-fade-in-up auth-delay-3 hidden lg:block">
                    &copy; @DateTime.Now.Year El Rancho Sagrado
                </p>
            </div>
        </div>

        <!-- Panel de formulario -->
        <div class="w-full lg:w-1/2 flex items-center justify-center p-md lg:p-xl">
            <main class="w-full max-w-[420px] animate-fade-in-up auth-delay-1">
                <button class="mb-lg flex items-center gap-xs text-on-surface-variant hover:text-primary transition-colors" type="button" onclick="window.location.href='@Url.Action("Login", "Login")'">
                    <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                    <span class="font-label-md text-label-md">Volver al inicio de sesion</span>
                </button>
                <div class="mb-lg">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight mb-xs">Registra tu cuenta</h1>
                    <p class="font-body-md text-body-md text-on-surface-variant">Crea tu acceso al sistema en minutos.</p>
                </div>
                <form class="space-y-md" asp-controller="Login" asp-action="Registro" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-error text-body-md"></div>
                    <div class="space-y-base">
                        <label class="font-label-md text-label-md text-on-surface-variant block" for="Username">Nombre Completo</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">badge</span>
                            <input class="@Cls("Nombre_Usuario")" id="Username" placeholder="Nombre y apellidos" type="text" required asp-for="Nombre_Usuario" />
                        </div>
                        <span asp-validation-for="Nombre_Usuario" class="text-error text-label-md"></span>
                    </div>
                    <div class="space-y-base">
                        <label class="font-label-md text-label-md text-on-surface-variant block" for="Email">Correo Electronico</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">mail</span>
                            <input class="@Cls("Email")" id="Email" placeholder="admin@restaurante.com" type="email" required asp-for="Email" />
                        </div>
                        <span asp-validation-for="Email" class="text-error text-label-md"></span>
                    </div>
                    <div class="space-y-base">
                        <label class="font-label-md text-label-md text-on-surface-variant block" for="Password">Contraseña</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock</span>
                            <input class="@Cls("Password")" id="Password" placeholder="Crea una contraseña segura" type="password" required asp-for="Password" />
                        </div>
                        <p class="font-label-md text-label-md text-on-surface-variant">Mínimo 8 caracteres, con al menos una letra y un número.</p>
                        <span asp-validation-for="Password" class="text-error text-label-md"></span>
                    </div>
                    <div class="space-y-base">
                        <label class="font-label-md text-label-md text-on-surface-variant block" for="RepeatPassword">Repite la Contraseña</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">lock_reset</span>
                            <input class="@Cls("RepeatPassword")" id="RepeatPassword" placeholder="Repite tu contraseña" type="password" required asp-for="RepeatPassword" />
                        </div>
                        <span asp-validation-for="RepeatPassword" class="text-error text-label-md"></span>
                    </div>
                    <button class="w-full h-12 bg-primary hover:bg-on-primary-fixed-variant text-white font-title-md text-title-md uppercase tracking-wide rounded-lg shadow-lg shadow-primary/20 active:scale-[0.98] transition-all duration-150 flex items-center justify-center gap-sm mt-lg" type="submit">
                        Registrate
                        <span class="material-symbols-outlined">arrow_forward</span>
                    </button>
                </form>
                @if (ViewData["Msg"] != null)
                {
                    <div class="mt-md p-base rounded-lg bg-error-container text-on-error-container font-body-md text-body-md text-center">
                        @ViewData["Msg"]
                    </div>
                }
                <div class="mt-lg pt-lg border-t border-outline-variant/30">
                    <p class="text-center font-body-md text-body-md text-on-surface-variant">
                        ¿Ya tienes una cuenta?
                        <a class="text-primary font-bold hover:underline" asp-controller="Login" asp-action="Login">Iniciar Sesion</a>
                    </p>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
