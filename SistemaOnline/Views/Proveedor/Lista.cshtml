@model List<SistemaOnline.ViewModels.ProveedorVM>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Proveedores";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Proveedores";
    ViewData["Descripcion"] = "Administra los proveedores registrados.";
    ViewData["Controlador"] = "Proveedor";
    ViewData["NuevoTexto"] = "Nuevo Proveedor";
    ViewData["BuscadorPlaceholder"] = "Buscar por nombre, RUC, email...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Nombre Empresa</th>
                    <th class="px-md pb-md font-bold">RUC</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Email de Contacto</th>
                    <th class="px-md pb-md font-bold">Teléfono</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Dirección</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Tipo de Suministro</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Proveedor</td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.Nombre_Empresa">@item.Nombre_Empresa</td>
                        <td class="px-md py-md font-mono-data">@item.RUC</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Email_Contacto">@item.Email_Contacto</td>
                        <td class="px-md py-md">@item.Telefono</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Direccion">@item.Direccion</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Tipo_Suministro">@item.Tipo_Suministro</td>
                        <td class="px-md py-md">@item.Estado</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Proveedor" asp-action="Editar" asp-route-id="@item.ID_Proveedor" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Proveedor" asp-action="Eliminar" asp-route-id="@item.ID_Proveedor" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />