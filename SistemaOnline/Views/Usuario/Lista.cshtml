@model List<SistemaOnline.ViewModels.UsuarioVM>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Usuarios";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Usuarios";
    ViewData["Descripcion"] = "Administra los usuarios registrados.";
    ViewData["Controlador"] = "Usuario";
    ViewData["NuevoTexto"] = "Nuevo Usuario";
    ViewData["BuscadorPlaceholder"] = "Buscar por nombre de usuario, email...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Nombre Usuario</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Email</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold">Rol</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Usuario</td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.Nombre_Usuario">@item.Nombre_Usuario</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Email">@item.Email</td>
                        <td class="px-md py-md">@(item.Estado ? "Activo" : "Inactivo")</td>
                        <td class="px-md py-md">@item.RolNombre</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Usuario" asp-action="Editar" asp-route-id="@item.ID_Usuario" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Usuario" asp-action="Eliminar" asp-route-id="@item.ID_Usuario" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />