@model List<SistemaOnline.Models.Pedido>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Facturación";
    ViewBag.Active = "facturacion";
    ViewData["Controlador"] = "Cajero";
    ViewData["AccionLista"] = "Facturacion";
}

<div class="mb-lg">
    <h2 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight">Facturación</h2>
    <p class="text-on-surface-variant">Listado de pedidos para facturación.</p>
</div>

<div class="mb-md relative max-w-md">
    <span class="material-symbols-outlined absolute left-md top-1/2 -translate-y-1/2 text-outline">search</span>
    <input id="buscadorTabla" type="text" placeholder="Buscar por mesa, estado..."
           class="w-full h-12 pl-[48px] pr-md bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all duration-300 font-body-md text-body-md text-on-surface placeholder:text-outline/60" />
</div>
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold">Fecha</th>
                    <th class="px-md pb-md font-bold">Mesa</th>
                    <th class="px-md pb-md font-bold">Subtotal</th>
                    <th class="px-md pb-md font-bold">Total</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold"></th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var p in Model)
                {
                    var cobrable = p.Estado_Pedido == "Pendiente" || p.Estado_Pedido == "Servido";
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">#@p.ID_Pedido</td>
                        <td class="px-md py-md">@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="px-md py-md">@(p.Mesa_Restaurante != null ? "Mesa " + p.Mesa_Restaurante.Numero_Mesa : "-")</td>
                        <td class="px-md py-md font-mono-data">@p.SubTotal.ToString("C2")</td>
                        <td class="px-md py-md font-bold">@p.Total.ToString("C2")</td>
                        <td class="px-md py-md">
                            <span class="px-sm py-xs bg-primary-container text-on-primary-container rounded-full text-label-md">@p.Estado_Pedido</span>
                        </td>
                        <td class="px-md py-md text-right">
                            @if (p.Estado_Pedido == "Pagado")
                            {
                                <span class="inline-flex items-center gap-xs h-9 px-sm bg-secondary-container text-on-secondary-container font-label-md text-label-md rounded-lg cursor-default select-none">
                                    <span class="material-symbols-outlined text-[16px]">check_circle</span> Cobrado
                                </span>
                            }
                            else if (cobrable)
                            {
                                <a asp-controller="Comprobante_Pago" asp-action="Nuevo" asp-route-idPedido="@p.ID_Pedido" class="inline-flex items-center gap-xs h-9 px-sm bg-primary hover:bg-on-primary-fixed-variant text-on-primary font-label-md text-label-md rounded-lg transition-all">
                                    <span class="material-symbols-outlined text-[16px]">point_of_sale</span> Cobrar
                                </a>
                            }
                            else
                            {
                                <button type="button" disabled class="inline-flex items-center gap-xs h-9 px-sm bg-surface-container-high text-on-surface-variant font-label-md text-label-md rounded-lg cursor-not-allowed">
                                    <span class="material-symbols-outlined text-[16px]">point_of_sale</span> Cobrar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />