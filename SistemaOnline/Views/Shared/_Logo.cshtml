@model string
@inject SistemaOnline.Services.LogoService LogoSistema
@*
    Logo del sistema. Modelo: clases de tamaño (p. ej. "w-20 h-20").
    Si no se ha subido ningún logo, muestra el icono "sin logo": silueta dentro de un círculo
    rodeado por una línea punteada, para indicar dónde irá el logo.
*@
@{
    string tamano = string.IsNullOrWhiteSpace(Model) ? "w-20 h-20" : Model;
}
@if (LogoSistema.TieneLogo)
{
    <img src="@Url.Action("Logo", "Configuracion", new { v = LogoSistema.Version })" alt="Logo del sistema" class="@tamano object-contain" />
}
else
{
    <div class="@tamano rounded-full border-2 border-dashed border-outline p-1 flex items-center justify-center"
         role="img" aria-label="Sin logo" title="Sin logo: súbelo desde Configuración">
        <svg viewBox="0 0 100 100" class="w-full h-full" aria-hidden="true">
            <circle cx="50" cy="50" r="50" fill="#BCC6C7" />
            <circle cx="50" cy="38" r="15" fill="#FFFFFF" />
            <path d="M24 72 C24 58 36 52 50 52 C64 52 76 58 76 72 C76 76 74 78 70 78 L30 78 C26 78 24 76 24 72 Z" fill="#FFFFFF" />
        </svg>
    </div>
}