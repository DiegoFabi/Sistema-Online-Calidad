@model List<SistemaOnline.ViewModels.ReservacionVM>
@using SistemaOnline.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reservaciones";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Reservaciones";
    ViewData["Descripcion"] = "Administra las reservaciones del restaurante.";
    ViewData["Controlador"] = "Reservacion";
    ViewData["NuevoTexto"] = "Nueva Reservación";
    ViewData["BuscadorPlaceholder"] = "Buscar por cliente, mesa, estado...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold">Fecha y Hora</th>
                    <th class="px-md pb-md font-bold">N° Personas</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Ocasión Especial</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Notas</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Cliente</th>
                    <th class="px-md pb-md font-bold">Mesa</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Reservacion</td>
                        <td class="px-md py-md font-mono-data">@item.Fecha_Hora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="px-md py-md font-mono-data">@item.Numero_Personas</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Ocasion_Especial">@item.Ocasion_Especial</td>
                        <td class="px-md py-md">
                            <span class="px-sm py-xs rounded-full text-label-md font-bold @EstadoColores.Reservacion(item.Estado_Reservacion)">@item.Estado_Reservacion</span>
                        </td>
                        <td class="px-md py-md col-ellipsis" title="@item.Notas">@item.Notas</td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.ClienteNombre">@item.ClienteNombre</td>
                        <td class="px-md py-md">@item.MesaNumero</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Reservacion" asp-action="Editar" asp-route-id="@item.ID_Reservacion" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Reservacion" asp-action="Eliminar" asp-route-id="@item.ID_Reservacion" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />