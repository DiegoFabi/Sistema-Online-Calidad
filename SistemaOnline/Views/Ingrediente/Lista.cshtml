@model List<SistemaOnline.ViewModels.IngredienteVM>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Ingredientes";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Ingredientes";
    ViewData["Descripcion"] = "Administra los ingredientes registrados.";
    ViewData["Controlador"] = "Ingrediente";
    ViewData["NuevoTexto"] = "Nuevo Ingrediente";
    ViewData["BuscadorPlaceholder"] = "Buscar por nombre, unidad, categoría...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Nombre</th>
                    <th class="px-md pb-md font-bold">Unidad de Medida</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Descripción</th>
                    <th class="px-md pb-md font-bold">Costo Unitario</th>
                    <th class="px-md pb-md font-bold">Activo</th>
                    <th class="px-md pb-md font-bold">Categoría</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Ingrediente</td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.Nombre_Ingrediente">@item.Nombre_Ingrediente</td>
                        <td class="px-md py-md">@item.Unidad_Medida</td>
                        <td class="px-md py-md col-ellipsis" title="@item.Descripcion">@item.Descripcion</td>
                        <td class="px-md py-md font-mono-data">@item.Costo_Unitario</td>
                        <td class="px-md py-md">@(item.Estado ? "Sí" : "No")</td>
                        <td class="px-md py-md">@item.CategoriaNombre</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Ingrediente" asp-action="Editar" asp-route-id="@item.ID_Ingrediente" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Ingrediente" asp-action="Eliminar" asp-route-id="@item.ID_Ingrediente" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />