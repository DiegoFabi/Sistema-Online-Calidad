@model List<SistemaOnline.Models.Pedido>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Reportes";
    ViewBag.Active = "reportes";
    ViewData["Controlador"] = "Dashboard";
    ViewData["AccionLista"] = "Reportes";
    var categorias = ViewBag.CategoriasDisponibles as List<SistemaOnline.Models.Producto_Categoria> ?? new();
    var metodosPago = ViewBag.MetodosPagoDisponibles as List<string> ?? new();
    int? categoriaSel = ViewBag.CategoriaSeleccionada;
    string? metodoSel = ViewBag.MetodoPagoSeleccionado;
}

<div class="mb-lg flex flex-col sm:flex-row sm:items-center sm:justify-between gap-md">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight">Reporte de Ventas</h2>
        <p class="text-on-surface-variant">Historial completo de pedidos registrados.</p>
    </div>
    <form asp-controller="Dashboard" asp-action="Reportes" method="get" class="flex flex-wrap items-center gap-sm">
        <select name="categoria" onchange="this.form.submit()"
                class="h-11 px-md bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface">
            <option value="">Todas las categorías</option>
            @foreach (var c in categorias)
            {
                <option value="@c.ID_Categoria" selected="@(categoriaSel == c.ID_Categoria ? "selected" : null)">@c.Nombre_Categoria</option>
            }
        </select>
        <select name="metodoPago" onchange="this.form.submit()"
                class="h-11 px-md bg-surface-container-low border-none rounded-lg focus:ring-2 focus:ring-primary/20 transition-all font-body-md text-body-md text-on-surface">
            <option value="">Todos los métodos de pago</option>
            @foreach (var m in metodosPago)
            {
                <option value="@m" selected="@(metodoSel == m ? "selected" : null)">@m</option>
            }
        </select>
        @if (categoriaSel.HasValue || !string.IsNullOrWhiteSpace(metodoSel))
        {
            <a asp-controller="Dashboard" asp-action="Reportes" class="inline-flex items-center gap-xs h-11 px-md bg-surface-container-high text-on-surface font-label-md text-label-md rounded-lg hover:bg-surface-container-highest transition-all">
                <span class="material-symbols-outlined text-[16px]">close</span> Limpiar filtros
            </a>
        }
    </form>
</div>

<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg">
        @if (!Model.Any())
        {
            <p class="text-on-surface-variant text-body-md">No hay pedidos que coincidan con los filtros seleccionados.</p>
        }
        else
        {
        <table class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold">Fecha</th>
                    <th class="px-md pb-md font-bold">Subtotal</th>
                    <th class="px-md pb-md font-bold">Total</th>
                    <th class="px-md pb-md font-bold">Estado</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var p in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">#@p.ID_Pedido</td>
                        <td class="px-md py-md">@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="px-md py-md font-mono-data">@p.SubTotal.ToString("C2")</td>
                        <td class="px-md py-md font-bold">@p.Total.ToString("C2")</td>
                        <td class="px-md py-md">
                            <span class="px-sm py-xs bg-primary-container text-on-primary-container rounded-full text-label-md">@p.Estado_Pedido</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    </div>
</div>
<partial name="_Pagination" />