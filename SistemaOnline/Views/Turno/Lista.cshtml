@model List<SistemaOnline.ViewModels.TurnoVM>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Turnos";
    ViewBag.Active = "negocio";
    ViewData["Titulo"] = "Lista de Turnos";
    ViewData["Descripcion"] = "Administra los turnos del restaurante.";
    ViewData["Controlador"] = "Turno";
    ViewData["NuevoTexto"] = "Nuevo Turno";
    ViewData["BuscadorPlaceholder"] = "Buscar por nombre, días...";
}
<partial name="_CRUDListLayout" />
<div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/20 overflow-hidden">
    <div class="p-lg overflow-x-auto">
        <table id="tablaPrincipal" class="w-full text-left">
            <thead class="text-label-md text-on-surface-variant uppercase tracking-wider">
                <tr>
                    <th class="px-md pb-md font-bold">ID</th>
                    <th class="px-md pb-md font-bold col-ellipsis">Nombre</th>
                    <th class="px-md pb-md font-bold">Hora Inicio</th>
                    <th class="px-md pb-md font-bold">Hora Fin</th>
                    <th class="px-md pb-md font-bold">Días de la Semana</th>
                    <th class="px-md pb-md font-bold">Acciones</th>
                </tr>
            </thead>
            <tbody class="text-body-md">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors border-b border-outline-variant/10">
                        <td class="px-md py-md font-mono-data">@item.ID_Turno</td>
                        <td class="px-md py-md font-bold col-ellipsis" title="@item.Nombre_Turno">@item.Nombre_Turno</td>
                        <td class="px-md py-md font-mono-data">@item.Hora_Inicio</td>
                        <td class="px-md py-md font-mono-data">@item.Hora_Fin</td>
                        <td class="px-md py-md">@item.Dias_Semana</td>
                        <td class="px-md py-md">
                            <div class="flex items-center gap-xs">
                                <a asp-controller="Turno" asp-action="Editar" asp-route-id="@item.ID_Turno" title="Editar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-tertiary hover:bg-surface-container-high transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">edit</span>
                                </a>
                                <a asp-controller="Turno" asp-action="Eliminar" asp-route-id="@item.ID_Turno" title="Eliminar"
                                   class="w-8 h-8 inline-flex items-center justify-center rounded-full text-error hover:bg-error-container/40 transition-colors">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" />